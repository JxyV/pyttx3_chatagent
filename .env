# ====================================
# 阿里云DashScope API配置（必需）
# ====================================
# 获取API密钥: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-8fae5f3d1cdd4e2dbabce5b6340a05c8

# ====================================
# 语音识别配置
# ====================================
# 启用本地流式识别
STT_TYPE=paraformer
PARAFORMER_STREAMING=false
LOG_LEVEL=INFO

# ====================================
# 语音合成配置
# ====================================
TTS_MODEL=qwen3-tts-flash-realtime  # 实时语音合成模型
TTS_VOICE=Cherry                    # 语音类型

# ====================================
# WebSocket服务配置
# ====================================
WS_HOST=localhost
WS_PORT=8000

# ====================================
# LLM配置
# ====================================
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2:7b
LLM_TEMPERATURE=0.1
